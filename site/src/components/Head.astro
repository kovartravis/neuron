---
// Overrides Starlight's default Head to stack a `TechArticle` JSON-LD block
// onto every docs page, per Map — SEO & GEO Groundwork's Ticket 3
// (Structured Data & Schema.org Strategy): one template-level rule, no
// per-page judgment calls about which pages count as technical.
//
// `FAQPage` is deliberately not added here — Ticket 3 scopes it to four
// pages with a *visible* Q&A block already in their content (homepage,
// Getting Started, CLI Reference, alternatives/comparison), and only the
// homepage (site/src/pages/index.astro) currently has one. Adding the
// markup to the other three without matching visible content would violate
// Ticket 3's own "no markup for synthetic or hidden questions" rule — see
// Map — neuron.github.io Site (2.5.0)'s new ticket for closing that gap.
import Default from '@astrojs/starlight/components/Head.astro';

const { entry, lastUpdated } = Astro.locals.starlightRoute;
const { title, description } = entry.data;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const person = {
	'@type': 'Person',
	name: 'Travis Kovar',
	url: 'https://github.com/kovartravis',
};

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: title,
	description,
	url: canonicalUrl,
	author: person,
	...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
};
---

<Default />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
