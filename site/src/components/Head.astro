---
// Overrides Starlight's default Head to stack `TechArticle` JSON-LD onto
// every docs page, per Map — SEO & GEO Groundwork's Ticket 3 (Structured
// Data & Schema.org Strategy): one template-level rule, no per-page
// judgment calls about which pages count as technical.
//
// `FAQPage` stacks additionally when a page's frontmatter declares `faq` —
// Ticket 3 scopes it to pages with a *visible* Q&A block already in their
// content, so `faq` is the single source for both the rendered "## Questions"
// section and this markup, never markup alone (Ticket 3's "no synthetic or
// hidden questions" rule).
import Default from '@astrojs/starlight/components/Head.astro';

const { entry, lastUpdated } = Astro.locals.starlightRoute;
const { title, description, faq } = entry.data;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const person = {
	'@type': 'Person',
	name: 'Travis Kovar',
	url: 'https://github.com/kovartravis',
};

const techArticle = {
	'@type': 'TechArticle',
	headline: title,
	description,
	url: canonicalUrl,
	author: person,
	...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
};

const jsonLd =
	faq && faq.length > 0
		? {
				'@context': 'https://schema.org',
				'@graph': [
					techArticle,
					{
						'@type': 'FAQPage',
						mainEntity: faq.map(({ q, a }) => ({
							'@type': 'Question',
							name: q,
							acceptedAnswer: { '@type': 'Answer', text: a },
						})),
					},
				],
			}
		: { '@context': 'https://schema.org', ...techArticle };
---

<Default />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
