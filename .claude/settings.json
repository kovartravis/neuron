{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "neuron",
            "args": [
              "hook",
              "claude-code",
              "session-start"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "neuron",
            "args": [
              "hook",
              "claude-code",
              "pre-prompt"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "neuron",
            "args": [
              "hook",
              "claude-code",
              "context-reset"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "neuron",
            "args": [
              "hook",
              "claude-code",
              "post-tool-use"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "neuron",
            "args": [
              "hook",
              "claude-code",
              "pre-command"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
