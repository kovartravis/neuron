{
  "name": "@kovartravis/neuron",
  "version": "1.3.4",
  "description": "Local-only agent memory store CLI",
  "keywords": [
    "agent-memory",
    "ai-agents",
    "ai-coding-assistant",
    "cli",
    "developer-tools",
    "embeddings",
    "huggingface",
    "nodejs",
    "onnx",
    "semantic-search",
    "sqlite",
    "transformers-js",
    "typescript",
    "vector-database",
    "vector-search",
    "local-vector-search"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "neuron": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovartravis/neuron.git"
  },
  "bugs": {
    "url": "https://github.com/kovartravis/neuron/issues"
  },
  "homepage": "https://github.com/kovartravis/neuron#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".agents/skills/neuron-memory/"
  ],
  "scripts": {
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "build": "node ./node_modules/typescript/bin/tsc",
    "prepublishOnly": "npm run build && chmod +x dist/cli.js",
    "start": "node ./dist/cli.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "better-sqlite3": "^11.0.0",
    "env-paths": "^3.0.0"
  },
  "overrides": {
    "onnxruntime-node": "1.20.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
