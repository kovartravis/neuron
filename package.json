{
  "name": "@kovartravis/neuron",
  "version": "2.4.4",
  "description": "Local-only agent memory store CLI",
  "keywords": [
    "agent-memory",
    "ai-agents",
    "ai-coding-assistant",
    "cli",
    "developer-tools",
    "embeddings",
    "huggingface",
    "nodejs",
    "onnx",
    "semantic-search",
    "sqlite",
    "transformers-js",
    "typescript",
    "vector-database",
    "vector-search",
    "local-vector-search"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "bin": {
    "neuron": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovartravis/neuron.git"
  },
  "bugs": {
    "url": "https://github.com/kovartravis/neuron/issues"
  },
  "homepage": "https://github.com/kovartravis/neuron#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".claude/skills/neuron-memory/",
    "docs/images/"
  ],
  "scripts": {
    "test": "npm run build && node ./node_modules/vitest/vitest.mjs run --dir src",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:e2e": "node benchmarks/e2e-runner.js",
    "bench": "node benchmarks/e2e-runner.js --full",
    "bench:report": "node benchmarks/e2e-runner.js --report-only",
    "bench:view": "node benchmarks/open-report.js",
    "bench:token-ab": "node benchmarks/token-ab/run.mjs",
    "bench:token-ab:dry-run": "node benchmarks/token-ab/run.mjs --dry-run",
    "bench:gitlog-ab": "node benchmarks/token-ab/run-gitlog-ab.mjs",
    "bench:gitlog-ab:dry-run": "node benchmarks/token-ab/run-gitlog-ab.mjs --dry-run",
    "bench:swebench-ab:pilot": "node benchmarks/token-ab/run-swebench-ab.mjs --pilot",
    "bench:swebench-ab": "node benchmarks/token-ab/run-swebench-ab.mjs",
    "bench:swebench-ab:dry-run": "node benchmarks/token-ab/run-swebench-ab.mjs --dry-run",
    "bench:swebench-ab:pilot:dry-run": "node benchmarks/token-ab/run-swebench-ab.mjs --pilot --dry-run",
    "build": "node ./node_modules/typescript/bin/tsc",
    "build:binary": "node scripts/build-binary.mjs",
    "prepublishOnly": "npm run build && chmod +x dist/cli.js",
    "postinstall": "node -e \"if (process.platform === 'android') { try { require('child_process').execSync('termux-fix-shebang dist/cli.js 2>/dev/null || true'); } catch(e){} }\"",
    "start": "node ./dist/cli.js",
    "bench:swebench-ab:discovery": "node benchmarks/token-ab/run-swebench-ab.mjs --arms=memory,control",
    "bench:hint-follow": "node benchmarks/hint-follow/analyze.mjs",
    "bench:write-compliance-ab": "node benchmarks/write-compliance-ab/run.mjs",
    "bench:write-compliance-ab:dry-run": "node benchmarks/write-compliance-ab/run.mjs --dry-run",
    "bench:write-compliance-ab:hard": "node benchmarks/write-compliance-ab/run-hard.mjs",
    "bench:write-compliance-ab:hard:dry-run": "node benchmarks/write-compliance-ab/run-hard.mjs --dry-run"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "env-paths": "^3.0.0",
    "onnxruntime-web": "^1.21.0",
    "web-tree-sitter": "^0.26.11",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0",
    "onnxruntime-node": "1.20.1"
  },
  "overrides": {
    "onnxruntime-node": "1.20.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
